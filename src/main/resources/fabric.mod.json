{
	"schemaVersion": 1,
	"id": "examplemod",
	"version": "${version}",

	"name": "Example Mod",
	"description": "This mod aims to help new BTA modders.",
	"authors": [
		"Turnip Labs"
	],
	"contact": {
		"homepage": "",
		"sources": ""
	},

	"license": "CC0-1.0",

	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"adapter": "kotlin",
				"value": "turniplabs.examplemod.ExampleMod"
			}
		],
		"beforeGameStart": [
			{
				"adapter": "kotlin",
				"value": "turniplabs.examplemod.ExampleMod"
			}
		],
		"afterGameStart": [
			{
				"adapter": "kotlin",
				"value": "turniplabs.examplemod.ExampleMod"
			}
		],
		"recipesReady": [
			{
				"adapter": "kotlin",
				"value": "turniplabs.examplemod.ExampleMod"
			}
		]
	},
	"mixins": [
		"examplemod.mixins.json"
	],

	"depends": {
		"fabricloader": ">=${fabricloader}",
		"fabric-language-kotlin": ">=${fabric_language_kotlin}",
		"halplibe": ">=${halplibe}",
		"minecraft": "*",
		"java": ">=${java}"
	},
	"suggests": {
		"modmenu": ">=${modmenu}"
	}
}
